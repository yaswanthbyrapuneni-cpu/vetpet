# Copy this to ".env" at the repo root before running `docker compose up -d --build`.
# docker-compose reads this file both for its own ${VAR} substitution (POSTGRES_PASSWORD)
# and, via `env_file:`, to set the backend container's environment directly.
#
# This compose file publishes no ports and owns no domain/TLS — see the "Deploy on a
# shared host" section of the README. Your real domain is configured separately, as a
# block in the shared Caddy's own Caddyfile, not here.

# A strong password for the Postgres container — do not keep the "vetpet" dev default.
POSTGRES_PASSWORD=replace-with-a-long-random-password

VETPET_APP_NAME=Madina Vet Pet API
VETPET_APP_ENV=production
VETPET_DEBUG=false
VETPET_API_V1_PREFIX=/api/v1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
VETPET_JWT_SECRET_KEY=replace-this-with-a-long-random-secret
VETPET_JWT_ALGORITHM=HS256
VETPET_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Your real deployed origin(s) — the browser blocks every API call if this doesn't
# match exactly. Only matters once you have a domain pointed through the shared
# Caddy (see README); testing over the bare IP via docker-compose.override.yml is
# same-origin regardless of this value, so the placeholder below is fine until then.
VETPET_CORS_ORIGINS=["https://yourdomain.com"]

VETPET_UPLOAD_DIR=./uploads
VETPET_MAX_UPLOAD_BYTES=10485760

# MUST be false before real users touch this — mock mode returns the OTP code
# directly in the API response instead of sending an SMS.
VETPET_OTP_MOCK_MODE=false
VETPET_OTP_EXPIRY_SECONDS=300

# Twilio sends the OTP as a real SMS when VETPET_OTP_MOCK_MODE=false.
# From https://console.twilio.com, and the number you bought/were given there.
# Two things to know before relying on this for real users:
#  - A trial Twilio account can only send to numbers you've manually verified
#    in the console. Real pet owners' numbers won't receive anything until you
#    upgrade to a paid (pay-as-you-go) account.
#  - India requires DLT sender-ID registration for A2P SMS (a TRAI rule) —
#    without it, carriers often silently drop messages to Indian numbers even
#    from a paid account. Complete Twilio's India compliance/DLT registration
#    before counting on delivery.
VETPET_TWILIO_ACCOUNT_SID=
VETPET_TWILIO_AUTH_TOKEN=
VETPET_TWILIO_FROM_NUMBER=

# Razorpay LIVE-mode keys (not the rzp_test_... ones used in development).
VETPET_RAZORPAY_KEY_ID=
VETPET_RAZORPAY_KEY_SECRET=
