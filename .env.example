# Copy this file to .env for local development.
VETPET_APP_NAME=VetPet Connect API
VETPET_APP_ENV=development
VETPET_DEBUG=true
VETPET_API_V1_PREFIX=/api/v1
VETPET_DATABASE_URL=sqlite:///./vetpet.db
# PostgreSQL alternative:
# VETPET_DATABASE_URL=postgresql+psycopg://vetpet:vetpet@localhost:5432/vetpet
VETPET_JWT_SECRET_KEY=replace-this-with-a-long-random-secret
VETPET_JWT_ALGORITHM=HS256
VETPET_ACCESS_TOKEN_EXPIRE_MINUTES=30
VETPET_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
VETPET_UPLOAD_DIR=./uploads
VETPET_MAX_UPLOAD_BYTES=10485760
